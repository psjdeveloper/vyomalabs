
---
import Layout from '../layouts/Layout.astro';

const activities = [
  {
    number: '01',
    icon: '⌘',
    title: 'Developer Tools',
    description:
      'Creating frameworks, libraries and practical utilities that help developers build better software.',
    tags: ['Frameworks', 'Libraries', 'Utilities']
  },
  {
    number: '02',
    icon: '⌥',
    title: 'Open Source',
    description:
      'Contributing to open-source projects, improving existing work and supporting collaborative development.',
    tags: ['GitHub', 'Contributions', 'Collaboration']
  },
  {
    number: '03',
    icon: '⌕',
    title: 'Website Testing',
    description:
      'Exploring websites, identifying usability and functionality issues, and sharing meaningful feedback.',
    tags: ['Testing', 'Usability', 'Feedback']
  },
  {
    number: '04',
    icon: '✎',
    title: 'Technical Writing',
    description:
      'Writing blogs, tutorials and technical insights to make development knowledge easier to explore.',
    tags: ['Articles', 'Tutorials', 'Knowledge']
  }
];

const projects = [
  {
    number: '01',
    category: 'UI COMPONENT LIBRARY',
    name: 'YourUIKit',
    description:
      'A reusable UI component library created to help developers build interfaces with a more consistent workflow.',
    url: 'https://github.com/Vyoma-labs/youruikit',
    label: 'Explore repository'
  },
  {
    number: '02',
    category: 'CSS FRAMEWORK',
    name: 'VyomaCSS',
    description:
      'A CSS framework focused on reusable styling and making frontend development more convenient.',
    url: 'https://github.com/psjdeveloper/vyomacss',
    label: 'Explore repository'
  }
];
---

<Layout>
  <main>
    <!-- HERO -->
    <section class="hero" id="home">
      <div class="hero-content">
        <span class="hero-label">
          <span class="status-dot"></span>
          INDEPENDENT DEVELOPER INITIATIVE
        </span>

        <h1>Vyoma<span>Labs.</span></h1>

        <p class="hero-tagline">
          Contribute. <span>Develop.</span> Test.
        </p>

        <p class="hero-description">
          A space for building developer tools, supporting open source,
          testing the web and sharing technical knowledge.
        </p>

        <div class="hero-actions">
          <a href="#projects" class="primary-btn">
            Explore our projects <span>↗</span>
          </a>

          <a href="#about" class="secondary-btn">
            About VyomaLabs
          </a>
        </div>
      </div>

      <div class="hero-decoration" aria-hidden="true">
        <span>V</span>
      </div>

      <a href="#what-we-do" class="scroll-indicator" aria-label="Scroll to what we do">
        <span></span>
        SCROLL TO EXPLORE
      </a>
    </section>

    <!-- WHAT WE DO -->
    <section class="section" id="what-we-do">
      <div class="section-heading">
        <div>
          <span class="eyebrow">01 / WHAT WE DO</span>
          <h2>
            Ideas into tools.<br />
            Knowledge into impact<span>.</span>
          </h2>
        </div>

        <p>
          We explore different parts of the developer ecosystem,
          combining creation, collaboration, testing and learning.
        </p>
      </div>

      <div class="activity-grid">
        {activities.map((activity) => (
          <article class="activity-card">
            <div class="card-top">
              <span class="activity-icon" aria-hidden="true">
                {activity.icon}
              </span>
              <span class="number">{activity.number}</span>
            </div>

            <h3>{activity.title}</h3>
            <p>{activity.description}</p>

            <div class="tags">
              {activity.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ABOUT -->
    <section class="section about" id="about">
      <span class="eyebrow">02 / ABOUT VYOMALABS</span>

      <div class="about-grid">
        <div class="about-intro">
          <span class="about-symbol">V.</span>
          <h2>
            Built around<br />
            the developer<br />
            <span>ecosystem.</span>
          </h2>
        </div>

        <div class="about-content">
          <p class="about-lead">
            VyomaLabs is an independent, developer-focused technology
            initiative built around one simple idea: technology grows
            when people create, contribute and share.
          </p>

          <p>
            From developing frameworks and libraries to contributing
            to open-source projects, testing websites and publishing
            technical articles, our work is centred on exploring and
            improving the software ecosystem.
          </p>

          <div class="philosophy">
            <span>OUR PHILOSOPHY</span>
            <h3>Contribute. Develop. Test.</h3>
            <p>
              Learn by building. Grow by contributing.
              Improve through testing.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FOUNDER -->
    <section class="section founder" id="founder">
      <div class="founder-copy">
        <span class="eyebrow">03 / THE FOUNDER</span>
        <h2>
          People behind<br />
          the initiative<span>.</span>
        </h2>

        <p>
          VyomaLabs was founded by Prasoon Jadon with an interest in
          developer tools, open-source software and the wider technology
          ecosystem.
        </p>
      </div>

      <article class="founder-card">
        <div class="founder-avatar" aria-hidden="true">PJ</div>

        <div>
          <span class="founder-label">FOUNDER</span>
          <h3>Prasoon Jadon</h3>
          <p>Developer · Open-source enthusiast · Technical writer</p>
        </div>

        <span class="founder-mark">V.</span>
      </article>
    </section>

    <!-- PROJECTS -->
    <section class="section projects" id="projects">
      <span class="eyebrow">04 / OUR PROJECTS</span>

      <div class="work-heading">
        <h2>
          Tools for the<br />
          developer community<span>.</span>
        </h2>

        <p>
          Exploring ideas and building useful tools that make
          development more accessible and efficient.
        </p>
      </div>

      <div class="project-grid">
        {projects.map((project) => (
          <article class="project-card">
            <div class="project-top">
              <span class="project-number">{project.number}</span>
              <span class="project-arrow">↗</span>
            </div>

            <span class="project-category">
              {project.category}
            </span>

            <h3>{project.name}<span>.</span></h3>

            <p>{project.description}</p>

            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="project-link"
            >
              {project.label}
              <span>↗</span>
            </a>
          </article>
        ))}
      </div>

      <p class="projects-note">
        More experiments and contributions will appear here as they grow.
      </p>
    </section>

    <!-- CLOSING -->
    <section class="closing">
      <span class="eyebrow">THE VYOMALABS APPROACH</span>

      <h2>
        Keep building.<br />
        <span>Keep contributing.</span>
      </h2>

      <p>
        Good technology is not just built. It is tested,
        shared and improved.
      </p>

      <a href="#home" class="primary-btn">
        Back to top <span>↑</span>
      </a>
    </section>
  </main>
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 80px;
  }

  :global(body) {
    margin: 0;
    background: #080b12;
    color: #f5f7ff;
    font-family: Inter, Arial, sans-serif;
  }

  :global(a) {
    -webkit-tap-highlight-color: transparent;
  }

  main {
    overflow: hidden;
  }

  /* HERO */

  .hero {
    min-height: 88vh;
    min-height: 88svh;
    position: relative;
    display: grid;
    place-items: center;
    padding: 110px 24px 120px;
    text-align: center;
    isolation: isolate;
    background:
      radial-gradient(ellipse at 50% 35%, #6574ee24, transparent 55%),
      radial-gradient(ellipse at 80% 80%, #283c7520, transparent 50%);
  }

  .hero-content {
    max-width: 800px;
    z-index: 1;
  }

  .hero-label,
  .eyebrow {
    color: #929dff;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: 2.5px;
  }

  .hero-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 15px;
    border: 1px solid #333d64;
    border-radius: 30px;
    background: #11182a99;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #8994ff;
    box-shadow: 0 0 12px #8994ff;
  }

  .hero h1 {
    font-size: clamp(4rem, 12vw, 8rem);
    letter-spacing: -7px;
    line-height: 1;
    margin: 35px 0 20px;
    font-weight: 850;
  }

  .hero h1 span,
  .section h2 span,
  .closing h2 span {
    color: #8994ff;
  }

  .hero-tagline {
    color: #e0e5ff;
    font-size: clamp(1rem, 3vw, 1.3rem);
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: 700;
  }

  .hero-tagline span {
    color: #8994ff;
  }

  .hero-description {
    max-width: 540px;
    margin: 25px auto 30px;
    color: #9aa5bc;
    font-size: 1rem;
    line-height: 1.9;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .primary-btn,
  .secondary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 15px 23px;
    border-radius: 8px;
    text-decoration: none;
    font-size: .9rem;
    font-weight: 700;
    transition: .25s ease;
  }

  .primary-btn {
    color: white;
    background: #6574ee;
    border: 1px solid #6574ee;
  }

  .primary-btn:hover {
    background: #8290ff;
    border-color: #8290ff;
    transform: translateY(-3px);
  }

  .secondary-btn {
    color: #c7cee0;
    border: 1px solid #303a53;
    background: #11182780;
  }

  .secondary-btn:hover {
    border-color: #8994ff;
    color: white;
  }

  .hero-decoration {
    position: absolute;
    z-index: -1;
    right: 5%;
    top: 16%;
    color: #8994ff;
    opacity: .035;
    font-size: clamp(15rem, 35vw, 32rem);
    font-weight: 900;
    line-height: 1;
    user-select: none;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 28px;
    display: flex;
    align-items: center;
    gap: 12px;
    color: #64718a;
    text-decoration: none;
    font-size: .65rem;
    letter-spacing: 2px;
  }

  .scroll-indicator span {
    width: 25px;
    height: 1px;
    background: #8994ff;
  }

  /* GENERAL SECTIONS */

  .section {
    width: min(1150px, 100%);
    margin: 100px auto;
    padding: 30px 25px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 45px;
  }

  .section h2 {
    font-size: clamp(2.2rem, 6vw, 4rem);
    line-height: 1.12;
    letter-spacing: -2px;
    margin: 20px 0 0;
  }

  .section-heading > p,
  .work-heading > p {
    max-width: 390px;
    color: #929db3;
    font-size: .95rem;
    line-height: 1.9;
  }

  /* ACTIVITIES */

  .activity-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .activity-card {
    min-width: 0;
    padding: 30px;
    border: 1px solid #20283a;
    border-radius: 16px;
    background: linear-gradient(145deg, #111a2b, #0d1220);
    transition: transform .25s ease, border-color .25s ease;
  }

  .activity-card:hover {
    transform: translateY(-5px);
    border-color: #6574ee;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .activity-icon {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    color: #aab3ff;
    background: #202a45;
    font-size: 1.5rem;
  }

  .number {
    color: #65718b;
    font-family: monospace;
    font-size: .85rem;
  }

  .activity-card h3 {
    margin: 28px 0 12px;
    font-size: 1.35rem;
  }

  .activity-card p,
  .about-content p {
    color: #929db3;
    font-size: .94rem;
    line-height: 1.85;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }

  .tags span {
    padding: 6px 10px;
    border: 1px solid #28334b;
    border-radius: 6px;
    color: #aab6cc;
    font-size: .7rem;
  }

  /* ABOUT */

  .about {
    border-top: 1px solid #20283a;
    border-bottom: 1px solid #20283a;
    padding-top: 75px;
    padding-bottom: 75px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    margin-top: 35px;
  }

  .about-symbol {
    display: inline-block;
    color: #8994ff;
    font-size: 1.5rem;
    font-weight: 900;
    margin-bottom: 10px;
  }

  .about-intro h2 {
    margin-top: 0;
  }

  .about-lead {
    color: #e0e5f5 !important;
    font-size: 1.08rem !important;
  }

  .philosophy {
    margin-top: 35px;
    padding: 24px;
    border-left: 2px solid #8994ff;
    background: #111a2b;
  }

  .philosophy span,
  .founder-label {
    color: #8994ff;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .philosophy h3 {
    margin: 13px 0 8px;
    font-size: 1.35rem;
  }

  .philosophy p {
    margin-bottom: 0;
    font-size: .85rem;
  }

  /* FOUNDER */

  .founder {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 60px;
  }

  .founder-copy > p {
    max-width: 450px;
    color: #929db3;
    line-height: 1.9;
  }

  .founder-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 30px;
    border: 1px solid #28334b;
    border-radius: 16px;
    background: linear-gradient(145deg, #111a2b, #0d1220);
    overflow: hidden;
  }

  .founder-avatar {
    flex-shrink: 0;
    width: 65px;
    height: 65px;
    display: grid;
    place-items: center;
    border-radius: 16px;
    color: white;
    background: linear-gradient(135deg, #6574ee, #343f91);
    font-size: 1.3rem;
    font-weight: 800;
  }

  .founder-card h3 {
    margin: 8px 0;
    font-size: 1.3rem;
  }

  .founder-card p {
    margin: 0;
    color: #929db3;
    font-size: .8rem;
    line-height: 1.6;
  }

  .founder-mark {
    position: absolute;
    right: 15px;
    bottom: -25px;
    color: #8994ff;
    opacity: .06;
    font-size: 7rem;
    font-weight: 900;
  }

  /* PROJECTS */

  .projects {
    border-top: 1px solid #20283a;
    padding-top: 70px;
  }

  .work-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 35px;
    margin-bottom: 40px;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .project-card {
    position: relative;
    min-width: 0;
    padding: 30px;
    border: 1px solid #20283a;
    border-radius: 16px;
    background: linear-gradient(145deg, #111a2b, #0d1220);
    transition: transform .25s ease, border-color .25s ease;
  }

  .project-card:hover {
    transform: translateY(-5px);
    border-color: #6574ee;
  }

  .project-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 35px;
  }

  .project-number {
    color: #65718b;
    font-family: monospace;
    font-size: .85rem;
  }

  .project-arrow {
    color: #8994ff;
    font-size: 1.3rem;
  }

  .project-category {
    color: #8994ff;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .project-card h3 {
    margin: 15px 0 12px;
    font-size: 2rem;
    letter-spacing: -1px;
  }

  .project-card h3 span {
    color: #8994ff;
  }

  .project-card p {
    min-height: 75px;
    color: #929db3;
    font-size: .92rem;
    line-height: 1.8;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    margin-top: 15px;
    padding: 12px 16px;
    border: 1px solid #6574ee;
    border-radius: 8px;
    background: #6574ee18;
    color: #aeb7ff;
    text-decoration: none;
    font-size: .85rem;
    font-weight: 700;
    transition: .25s ease;
  }

  .project-link:hover {
    background: #6574ee;
    color: white;
  }

  .projects-note {
    margin-top: 25px;
    color: #64718a;
    font-size: .8rem;
    line-height: 1.7;
  }

  /* CLOSING */

  .closing {
    margin-top: 100px;
    padding: 100px 24px;
    text-align: center;
    border-top: 1px solid #20283a;
    background:
      radial-gradient(ellipse at 50% 100%, #6574ee20, transparent 65%);
  }

  .closing h2 {
    margin: 22px 0;
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 1.1;
    letter-spacing: -3px;
  }

  .closing p {
    margin: 0 auto 30px;
    max-width: 470px;
    color: #929db3;
    line-height: 1.8;
  }

  :global(a:focus-visible) {
    outline: 2px solid #aab3ff;
    outline-offset: 4px;
  }

  /* TABLET AND MOBILE */

  @media (max-width: 760px) {
    .hero {
      min-height: 78vh;
      padding: 90px 20px 110px;
    }

    .hero h1 {
      letter-spacing: -4px;
    }

    .hero-decoration {
      right: -5%;
      top: 25%;
    }

    .section {
      margin: 65px auto;
      padding: 25px 20px;
    }

    .section-heading,
    .work-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }

    .activity-grid,
    .about-grid,
    .founder,
    .project-grid {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    .about {
      padding-top: 55px;
      padding-bottom: 55px;
    }

    .founder-card {
      padding: 22px;
    }

    .closing {
      margin-top: 60px;
      padding: 75px 20px;
    }
  }

  @media (max-width: 420px) {
    .hero-label {
      font-size: .58rem;
      letter-spacing: 1.5px;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero h1 {
      font-size: 3.5rem;
      letter-spacing: -3px;
    }

    .activity-card,
    .project-card {
      padding: 23px;
    }

    .founder-card {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  /* ACCESSIBILITY */

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      transition-duration: .01ms !important;
      animation-duration: .01ms !important;
    }
  }
</style>
